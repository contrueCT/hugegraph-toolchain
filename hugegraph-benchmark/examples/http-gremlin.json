{
    "schemaVersion": 1,
    "kind": "http-benchmark-profile",
    "name": "gremlin-http-mechanics-v1",
    "endpoint": "http://127.0.0.1:18080/gremlin",
    "authorizationEnv": null,
    "target": {
        "label": "fill-target-before-use",
        "build": "record-exact-build-sha",
        "mode": "record-forward-or-embedded",
        "environment": "Record JVM, server configuration, host/container limits and competing work. This example checks tool mechanics.",
        "evidenceFiles": []
    },
    "cases": [
        {
            "id": "arithmetic",
            "body": {
                "gremlin": "x + 1",
                "bindings": {
                    "x": 1
                },
                "language": "gremlin-groovy"
            },
            "expectedStatus": 200,
            "checks": [
                {
                    "pointer": "/status/code",
                    "equals": 200
                },
                {
                    "pointer": "/result/data",
                    "equals": [2]
                }
            ]
        },
        {
            "id": "structured",
            "body": {
                "gremlin": "[[id: x, name: 'hgbench', values: [1, 2, 3]]]",
                "bindings": {
                    "x": 7
                },
                "language": "gremlin-groovy"
            },
            "expectedStatus": 200,
            "checks": [
                {
                    "pointer": "/status/code",
                    "equals": 200
                },
                {
                    "pointer": "/result/data",
                    "equals": [
                        {
                            "id": 7,
                            "name": "hgbench",
                            "values": [1, 2, 3]
                        }
                    ]
                }
            ]
        },
        {
            "id": "large-string",
            "body": {
                "gremlin": "'x' * n",
                "bindings": {
                    "n": 16384
                },
                "language": "gremlin-groovy"
            },
            "expectedStatus": 200,
            "checks": [
                {
                    "pointer": "/status/code",
                    "equals": 200
                },
                {
                    "pointer": "/result/data",
                    "equals": [
                        ""
                    ]
                }
            ]
        }
    ],
    "loads": [
        {
            "id": "arrival-10",
            "model": "open",
            "ratePerSecond": 10,
            "maxInFlight": 4,
            "maxStartDelayMs": 100
        }
    ],
    "repeats": 2,
    "warmupMs": 1000,
    "durationMs": 3000,
    "requestTimeoutMs": 2000,
    "drainMs": 2500,
    "maxRequestsPerPhase": 10000,
    "maxResponseBytes": 1048576,
    "maxTraceBytes": 16777216,
    "responseEncoding": "gzip"
}
